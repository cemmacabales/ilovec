# Supabase project (Settings > API). The anon key is public by design;
# Row Level Security keeps the data private to the two linked accounts.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# TMDB API key (https://www.themoviedb.org/settings/api). Server-side only:
# read by netlify/functions/tmdb.mts, and by the dev server's /api/tmdb proxy.
# No VITE_ prefix, so it never ends up in the client bundle.
TMDB_API_KEY=your_tmdb_api_key_here
